    <dcat:dataset>
      <dcat:Dataset rdf:about="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/406333f3-45a3-445e-9d2b-828c1d04708d">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="es">Unidades de demanda urbana (polígonos) PHC 2022-2027</dct:title>
        <dct:description xml:lang="es">Unidades de demanda urbana con geometría de polígonos definidos en los planes hidrológicos de demarcación de tercer ciclo (2022-2027). Según el artículo 13.3 del Reglamento de la Planificación hidrológica (RD 907/2007), las demandas de agua pertenecientes a un mismo uso que compartan el origen del suministro y cuyos retornos se reincorporen básicamente en la misma zona o subzona se agruparán en unidades territoriales más amplias, denominadas unidades de demanda.  En el caso de las unidades de demanda urbana el uso es el de Abastecimiento de población, incluyendo en su dotación la necesaria para industrias de poco consumo de agua situadas en los núcleos de población y conectadas a la red municipal.</dct:description>
        <dcat:landingPage rdf:resource="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/406333f3-45a3-445e-9d2b-828c1d04708d"/>
        <dct:identifier>406333f3-45a3-445e-9d2b-828c1d04708d</dct:identifier>
