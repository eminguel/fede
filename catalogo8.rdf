      <dcat:Dataset rdf:about="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/6132e91e-876a-4420-834b-d07ca6f451cb">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="es">Subcuencas nivales de las cuencas hidrográficas</dct:title>
        <dct:description xml:lang="es">Subcuencas nivales definidas dentro de las cuencas hidrográficas de la península, situadas en los principales sistemas montañosos, donde se localizan los recursos nivales y por tanto se han ubicado las redes de medida de nieve.</dct:description>
