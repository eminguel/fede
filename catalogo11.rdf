    <dcat:dataset>
      <dcat:Dataset rdf:about="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/d362b837-82a1-4fe9-b084-b1105d622a63">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="en">PRTR-Spain administrative and thematic data report on industrial facilities (IPPC+ Kiev Protocol).</dct:title>
        <dct:title xml:lang="es">Reporte datos administrativos y temáticos PRTR-España de instalaciones industriales ((IPPC+ Protocolo Kiev))</dct:title>
        <dct:description xml:lang="en">The dataset refers to industrial installations that according to industrial activity are within the scope of the Industrial Emissions Directive 2010/75/EU and Regulation (EC) 166/2006 on industrial emissions. &#13;
The information on installations includes administrative and thematic data for the reference period 2018 to 2022.</dct:description>
        <dct:description xml:lang="es">El conjunto de datos hacen referencia a las instalaciones industriales que según actividad industrial se encuentran dentro del ámbito de aplicación de la Directiva de emisiones industriales 2010/75/UE y el Reglamento (CE) 166/2006 sobre emisiones industriales. &#13;
la información de las instalaciones incluye datos administrativos y temáticos para el periodo de referencia 2018 a 2022.</dct:description>
        <dcat:landingPage rdf:resource="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/d362b837-82a1-4fe9-b084-b1105d622a63"/>
