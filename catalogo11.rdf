    <dcat:dataset>
      <dcat:Dataset rdf:about="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/f38bfc0d-6e2c-415a-bf12-b3535fc14d65">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="en">Greenhouse gas emissions projections 2025</dct:title>
        <dct:title xml:lang="es">Proyecciones de emisiones de gases de efecto invernadero 2025</dct:title>
        <dct:description xml:lang="en">Projected estimates of greenhouse gas (GHG) emissions and removals, according to the WeM (with existing measures) and WaM (with additional measures) scenarios. It is based on data from 2023, the last year inventoried in the 2025 edition of the GHG emissions inventory.</dct:description>
        <dct:description xml:lang="es">Estimaciones a futuro de las emisiones y absorciones de gases de efecto invernadero (GEI), según los escenarios WeM (con medidas existentes) y WaM (con medidas adicionales). Se parte de los datos del año 2023, último año inventariado del inventario de emisiones de GEI de la edición 2025.</dct:description>
        <dcat:landingPage rdf:resource="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/f38bfc0d-6e2c-415a-bf12-b3535fc14d65"/>
        <dct:identifier>f38bfc0d-6e2c-415a-bf12-b3535fc14d65</dct:identifier>
        <dct:accrualPeriodicity rdf:resource="http://publications.europa.eu/resource/authority/frequency/BIENNIAL"/>
        <dct:type rdf:resource="http://id.loc.gov/vocabulary/marcgt/dtb"/>
        <dcat:keyword xml:lang="es">emisiones-gei</dcat:keyword>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-11-13T00:00:00+00:00</dct:modified>
        <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-06-06T00:00:00+00:00</dct:issued>
        <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/SPA"/>
        <dcat:theme rdf:resource="http://datos.gob.es/kos/sector-publico/sector/medio-ambiente"/>
        <dcat:theme rdf:resource="http://publications.europa.eu/resource/authority/data-theme/ENVI"/>
        <dcat:contactPoint rdf:resource="https://catalogo.datosabiertos.miteco.gob.es/kos/role/E05068001/contact"/>
        <dct:creator>
          <foaf:Agent rdf:nodeID="Nc4d855d11e4649cb91072005a6d447eb">
            <foaf:name xml:lang="es">Sistema Español de Inventario y Proyecciones de Emisiones a la Atmósfera</foaf:name>
            <foaf:mbox rdf:resource="mailto:buzon-inv_emisiones@miteco.es"/>
            <foaf:homepage rdf:resource="https://www.miteco.gob.es/es/calidad-y-evaluacion-ambiental/temas/sistema-espanol-de-inventario-sei-/"/>
            <dct:type rdf:resource="http://purl.org/adms/publishertype/NationalAuthority"/>
            <dct:identifier>E05068001</dct:identifier>
          </foaf:Agent>
        </dct:creator>
        <dct:temporal>
          <dct:PeriodOfTime rdf:nodeID="N496726d2060c4c27bbd07593c371d34c">
            <dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-01-01T00:00:00+00:00</dcat:startDate>
            <dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2030-12-31T00:00:00+00:00</dcat:endDate>
          </dct:PeriodOfTime>
        </dct:temporal>
        <dct:spatial rdf:resource="http://datos.gob.es/recurso/sector-publico/territorio/Pais/España"/>
        <dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/>
        <dct:provenance>
          <dct:ProvenanceStatement rdf:nodeID="N2413ba467b624a16aa12d0deed97cbf3">
            <dct:description xml:lang="en">Emissions data from the latest National Emissions Inventory (1990-2023 series) prepared by the SEI are used and supplemented with the most up-to-date integrated energy projections (including GDP, population, and fuel/CO2 price forecasts) provided by the State Secretariat for Energy (SEE). The modeling process is structured in three key steps: first, the general macroeconomic framework is defined; second, sectoral modeling (Step 1) is carried out, using the TIMES-Synergy model for energy and industry and iteratively incorporating policies and measures (PaMs) to develop two scenarios, WeM (existing measures) and WaM (additional measures); and third, emissions estimation (Step 2) is performed by applying the National Inventory methodologies to the projected activity variables and a quality control check. Finally, the assumptions and results are adjusted in an iterative evaluation (Step 3) with the objectives of the PNIEC and the PNCCA.</dct:description>
            <dct:description xml:lang="es">Se recogen los datos de emisiones del último Inventario Nacional de Emisiones (serie 1990-2023) elaborado por el SEI, y se complementan con las proyecciones energéticas integradas más actualizadas (que incluyen previsiones de PIB, población y precios de combustibles/CO2) proporcionadas por la Secretaría de Estado de Energía (SEE). El proceso de modelización se estructura en tres pasos clave: primero, se define el marco macroeconómico general; segundo, se realiza la modelación sectorial (Paso 1), empleando el modelo TIMES-Sinergia para energía e industria e incorporando de manera iterativa las políticas y medidas (PaMs) para desarrollar dos escenarios, WeM (medidas existentes) y WaM (medidas adicionales); y tercero, se lleva a cabo la estimación de emisiones (Paso 2) aplicando las metodologías del Inventario Nacional a las variables de actividad proyectadas y un control de calidad. Finalmente, los supuestos y resultados se ajustan en una evaluación iterativa (Paso 3) con los objetivos del PNIEC y el PNCCA.</dct:description>
          </dct:ProvenanceStatement>
        </dct:provenance>
        <dct:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/>
