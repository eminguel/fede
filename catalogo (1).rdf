    <dcat:dataset>
      <dcat:Dataset rdf:about="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/978d97db-18e4-4daf-b445-0526666bd4f1">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="es">Red de lugares para el seguimiento de la Contaminación Atmosférica en los ecosistemas</dct:title>
        <dct:description xml:lang="es">La red de seguimiento de los impactos de la contaminación del aire en los ecosistemas en España, se recoge en los artículos 9 y  10 (4a) de la  Directiva (UE) 2016/2284 del Parlamento Europeo y del Consejo, de 14 de diciembre de 2016, relativa a la  reducción de las emisiones nacionales de determinados contaminantes atmosféricos. La red se compone de 46 puntos para el seguimiento nacional de  ecosistemas representativos de España y que son sensibles a la contaminación atmosférica: 25 estaciones de aguas (ríos y lagos);14 estaciones forestales; 1 estación con adquisición de datos integrada en hábitats terrestres y acuáticos y 6 estaciones de ozono que recoge cómo este contaminante afecta a los cultivos</dct:description>
        <dcat:landingPage rdf:resource="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/978d97db-18e4-4daf-b445-0526666bd4f1"/>
