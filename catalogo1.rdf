    <dcat:dataset>
      <dcat:Dataset rdf:about="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/6ee8d46f-93bd-478f-8e29-3ba4f6d8405c">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="en">Electric Vehicle Charging Points</dct:title>
        <dct:title xml:lang="es">Puntos de Recarga de Vehículos Eléctricos</dct:title>
        <dct:description xml:lang="en">Information on publicly accessible electric vehicle charging infrastructure.&#13;
&#13;
These are electric charging points located on public roads, at charging stations, petrol stations, shopping centres, etc.&#13;
&#13;
It contains information regarding ownership, location and characteristics of the charging points, including details such as the type of connector and power output.</dct:description>
        <dct:description xml:lang="es">Información de la infraestructura de recarga eléctrica de vehículos de acceso público.&#13;
&#13;
Se trata de puntos de recarga eléctrica situados en la vía pública, electrolineras, estaciones de servicio, centros comerciales, etc.&#13;
&#13;
Contiene la información relativa a titularidad de la explotación, localización y características de los puntos de recarga, incluyendo datos como el tipo de conector o la potencia.</dct:description>
        <dcat:landingPage rdf:resource="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/6ee8d46f-93bd-478f-8e29-3ba4f6d8405c"/>
        <dct:identifier>6ee8d46f-93bd-478f-8e29-3ba4f6d8405c</dct:identifier>
        <owl:versionInfo>1.0</owl:versionInfo>
        <dct:accrualPeriodicity rdf:resource="http://publications.europa.eu/resource/authority/frequency/IRREG"/>
