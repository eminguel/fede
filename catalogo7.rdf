      <dcat:Dataset rdf:about="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/9221d023-746f-493b-9716-f0d6733077a9">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="es">Mapa de áreas de riesgo inundación costera afección ambiental T=100 años</dct:title>
        <dct:description xml:lang="es">Mapas de riesgo ambiental (áreas) correspondientes a un escenario de probabilidad media de inundación (periodo de retorno de 100 años), teniendo en cuenta la información relativa a masas de agua, captaciones, zonas de uso recreativo y Hábitats.</dct:description>
