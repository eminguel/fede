<https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/00d5fcb9-1407-46ad-a3a1-ac163978cf52> a dcat:Dataset,
        foaf:Document ;
    dcatap:applicableLegislation <http://data.europa.eu/eli/reg_impl/2023/138/oj> ;
    dcatap:hvdCategory <http://data.europa.eu/bna/c_ac64a52d> ;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dct:conformsTo geodcatap:,
        <http://www.opengis.net/def/crs/EPSG/0/25830> ;
    dct:description """El Servicio WMS (Web Map Service) denominado "UME.Aeropuertos" permite la visualización y consulta del conjunto de datos que representan localización de los grandes aeropuertos sobre los que deben elaborar mapas estratégicos de ruido en aplicación de la Directiva 2002/49/CE sobre evaluación y gestión del ruido por soportar un tráfico aéreo superior a las 50.000 operaciones por año de despegue y aterrizaje. 3ª Fase de aplicación de la Directiva (2017). La presente versión corresponde a la información comunicada al Ministerio para la Transición Ecológica y el Reto Demográfico que había sido recibida hasta noviembre de 2021.
              La URL del servicio es la siguiente: https://gis.miteco.gob.es/geoserver/evaluacionambiental/ume_aeropuerto/wms
                    Los sistemas de referencia que ofrece este servicio son:
				- Para coordenadas geográficas: EPSG:4326 (WGS 84), EPSG:4258 (ETRS 89).
				- Para coordenadas U.T.M: EPSG:32627 (WGS 84 / UTM zone 27N),EPSG:32628 (WGS 84 / UTM zone 28N), EPSG:32629 (WGS 84 / UTM zone 29N), EPSG:32630 (WGS 84 / UTM zone 30N), EPSG:32631 (WGS 84 / UTM zone 31N), EPSG:25828 (ETRS 89 / UTM zone 28N), EPSG:25829 (ETRS 89 / UTM zone 29N), EPSG:25830 (ETRS 89 / UTM zone 30N), EPSG:25831 (ETRS 89 / UTM zone 31N).
  - Otros sistemas de referencia: EPSG:3857 (Proyección WGS84 / Pseudo-Mercator)."""@es ;
    dct:identifier "00d5fcb9-1407-46ad-a3a1-ac163978cf52" ;
    dct:isReferencedBy <https://www.mapama.gob.es/ide/metadatos/srv/spa/csw?service=CSW&version=2.0.2&request=GetRecordById&id=00d5fcb9-1407-46ad-a3a1-ac163978cf52&elementSetName=full&outputSchema=http://www.isotc211.org/2005/gmd&OutputFormat=application/xml> ;
    dct:issued "2026-07-09T00:00:00+00:00"^^xsd:dateTime ;
