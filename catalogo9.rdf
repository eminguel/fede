    <dcat:dataset>
      <dcat:Dataset rdf:about="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/15433535-363b-4a5b-8d46-ff691862e821">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="es">Zonas con potenciales alto y moderado de entrada de nutrientes en la Demarcación del Estrecho y Alborán (EM ESAL PRE ZO Nutrientes)</dct:title>
        <dct:description xml:lang="es">Se han seleccionado zonas de potencial acumulación de nutrientes a partir de las celdas clasificadas por los rangos “Muy Alto” y “Alto” del mallado de nutrientes de la Demarcación del Estrecho y Alborán. Además se ha completado el análisis de nutrientes con los trabajos realizados en el marco de otras directivas (Directiva Marco del Agua, Directiva de Aguas Residuales y Directiva de Nitratos).</dct:description>
        <dcat:landingPage rdf:resource="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/15433535-363b-4a5b-8d46-ff691862e821"/>
