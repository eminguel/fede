    <dcat:dataset>
      <dcat:Dataset rdf:about="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/dce793d5-ca5d-44d0-ad9d-ca2a5f7db82f">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="es">Zonas con potenciales alto y moderado de generación de ruido submarino en la Demarcación del Estrecho y Alborán (EM ESAL PRE ZO Ruido Submarino)</dct:title>
        <dct:description xml:lang="es">Se han identificado como zonas con alto potencial de generación de ruido submarino aquellas que contienen celdas con valores "Alto" y "Muy alto", y zonas con potencial moderado aquellas que contienen celdas con valores "Medio" y "Alto" del Mallado de ruido de la Demarcación del Estrecho y Alborán.</dct:description>
