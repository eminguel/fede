    <dcat:dataset>
      <dcat:Dataset rdf:about="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/52b58bb0-19ad-482b-a837-b5dbb8665931">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="es">Servicio WFS (Web Feature Service) Demarcaciones hidrográficas (ámbito terrestre)</dct:title>
        <dct:description xml:lang="es">El Servico WFS (Web Feature Services) denominado Demarcaciones hidrográficas (ámbito terrestre) permite la visualización y consulta de los datos vectoriales y de la información alfanumérica asociada a la cartografía del ámbito terrestre, definidas de acuerdo con lo establecido en la Directiva Marco de Agua, sobre las demarcaciones hidrográficas de España.
				La URL del Servicio WFS Demarcaciones hidrográficas (ámbito terrestre) es: https://wmts.mapama.gob.es/sig/wfs_agua/demarcaciones_et/wfs
				Los sistemas de referencia que ofrece este servicio son para coordenadas geográficas: EPSG:4326 (WGS 84) y EPSG:4258 (ETRS 89).</dct:description>
        <dcat:landingPage rdf:resource="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/52b58bb0-19ad-482b-a837-b5dbb8665931"/>
