    <dcat:dataset>
      <dcat:Dataset rdf:about="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/fde3a668-d570-44a8-b4c3-00a49e8697df">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="es">Zonas con potenciales alto y moderado de generación de ruido submarino en la Demarcación Sudatlántica (EM SUD PRE ZO Ruido Submarino)</dct:title>
        <dct:description xml:lang="es">Las zonas con niveles de ruido potencialmente altos han sido seleccionadas porque contienen celdas del Mallado de ruido de la Demarcación sudatlántica con valores del índice de ruido altos, mientras que las zonas con niveles moderados contienen valores del índice de ruido medios.</dct:description>
