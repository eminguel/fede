    <dcat:service>
      <dcat:DataService rdf:about="https://wms.mapama.gob.es/sig/Agua/RedSegSuperficial/EmisionAtl">
        <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
        <dct:title xml:lang="en">Web Map Service (WMS)</dct:title>
        <dct:title xml:lang="es">Servicio Web de Mapas (WMS)</dct:title>
        <dct:description xml:lang="en">OGC Web Map Service (WMS) provides a simple HTTP interface for requesting geo-registered map images from one or more distributed geospatial databases. For more specific information, please check the endpoint description.</dct:description>
        <dct:description xml:lang="es">El servicio Web Map Service (WMS) definido por el Open Geospatial Consortium (OGC) permite visualizar información geográfica como mapas. Más información específica del servicio en la descripción del punto final (dcat:endpointDescription).</dct:description>
