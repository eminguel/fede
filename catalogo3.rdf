    <dcat:servesDataset>
      <dcat:Dataset rdf:about="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/9c678c84-4645-4d28-93bd-3db1d7f3f859">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="es">Masas de agua subterráneas (PHC 2022-2027) que no alcanzan el buen estado por razones cuantitativas</dct:title>
        <dct:description xml:lang="es">Masas de agua subterránea que no alcanzan el buen estado por razones cuantitativas. Cartografía pertinente para la aplicación de la Disposición adicional séptima sobre ahorros efectivos de agua en infraestructuras de regadío del Real Decreto 35/2023, de 24 de enero. Esta información es el resultado de la integración y posterior tratamiento de la información aportada por las 25 Demarcaciones Hidrográficas españolas, en aplicación del artículo 13 de la Directiva Marco del Agua (2000/60/UE) y ha sido oficialmente reportada a la Comisión europea. La delimitación geográfica de las masas de agua corresponde con las aprobadas oficialmente en los planes hidrológicos de cuenca del tercer ciclo de planificación 2022-2027</dct:description>
        <dcat:landingPage rdf:resource="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/9c678c84-4645-4d28-93bd-3db1d7f3f859"/>
