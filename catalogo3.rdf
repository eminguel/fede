    <dcat:dataset>
      <dcat:Dataset rdf:about="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/e64270b5-5226-45b4-8bdb-e7e07286c854">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="es">Rangos de Hábitat Artículo 17 (período 2013-2018)</dct:title>
        <dct:description xml:lang="es">Los tipos de hábitat de interés comunitario son un conjunto de ecosistemas seleccionados como especialmente relevantes para la conservación de la biodiversidad en la Unión Europea. Su protección está amparada por la Directiva 92/43/CEE o Directiva Hábitats. 
El presente conjunto de datos muestra el Rango geográfico, evaluado en el periodo 2013 a 2018, obtenido a partir de la distribución geográfica resultante de integrar los datos aportados por las administraciones competentes</dct:description>
        <dcat:landingPage rdf:resource="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/e64270b5-5226-45b4-8bdb-e7e07286c854"/>
