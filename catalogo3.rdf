  <dcat:DataService rdf:about="https://wms.mapama.gob.es/sig/Costas/POEM/ZAPID">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
    <dct:title xml:lang="en">Web Map Service (WMS)</dct:title>
    <dct:title xml:lang="es">Servicio Web de Mapas (WMS)</dct:title>
    <dct:description xml:lang="en">OGC Web Map Service (WMS) provides a simple HTTP interface for requesting geo-registered map images from one or more distributed geospatial databases. For more specific information, please check the endpoint description.</dct:description>
    <dct:description xml:lang="es">El servicio Web Map Service (WMS) definido por el Open Geospatial Consortium (OGC) permite visualizar información geográfica como mapas. Más información específica del servicio en la descripción del punto final (dcat:endpointDescription).</dct:description>
    <dcat:endpointDescription>
      <rdfs:Resource rdf:about="https://wms.mapama.gob.es/sig/Costas/POEM/ZAPID?request=GetCapabilities&amp;service=WMS"/>
    </dcat:endpointDescription>
    <dcat:endpointURL rdf:resource="https://wms.mapama.gob.es/sig/Costas/POEM/ZAPID"/>
    <dcat:servesDataset>
      <dcat:Dataset rdf:about="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/ddb72383-f276-4f8c-abfc-525b5462312e">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="es">Servicio WMS (Web Map Service) Zonas de alto potencial para la investigación, desarrollo e innovación (I+D+i)</dct:title>
        <dct:description xml:lang="es">El Servicio WMS (Web Map Service) denominado "Zonas de alto potencial para la investigación, desarrollo e innovación (I+D+i)" permite la visualización y consulta del conjunto de datos que representan la información cartográfica y alfanumérica de las zonas de alto potencial para la investigación, desarrollo e innovación (I+D+i) determinadas en los Planes de Ordenación del Espacio Marítimo (POEM). 
				La URL del servicio es la siguiente: https://wms.mapama.gob.es/sig/Costas/POEM/ZAPID
                Los sistemas de referencia que ofrece este servicio son:
				- Para coordenadas geográficas: EPSG:4326 (WGS 84), EPSG:4258 (ETRS 89).
				- Para coordenadas U.T.M: EPSG:32627 (WGS 84 / UTM zone 27N),EPSG:32628 (WGS 84 / UTM zone 28N), EPSG:32629 (WGS 84 / UTM zone 29N), EPSG:32630 (WGS 84 / UTM zone 30N), EPSG:32631 (WGS 84 / UTM zone 31N), EPSG:25828 (ETRS 89 / UTM zone 28N), EPSG:25829 (ETRS 89 / UTM zone 29N), EPSG:25830 (ETRS 89 / UTM zone 30N), EPSG:25831 (ETRS 89 / UTM zone 31N).
  - Otros sistemas de referencia: EPSG:3857 (Proyección WGS84 / Pseudo-Mercator).</dct:description>
        <dcat:landingPage rdf:resource="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/ddb72383-f276-4f8c-abfc-525b5462312e"/>
