  <dcat:DataService rdf:about="https://wms.mapama.gob.es/sig/Biodiversidad/RangosEspeciesArt17/2013-2018">
    <rdf:type rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
    <dct:title xml:lang="en">Web Map Service (WMS)</dct:title>
    <dct:title xml:lang="es">Servicio Web de Mapas (WMS)</dct:title>
    <dct:description xml:lang="en">OGC Web Map Service (WMS) provides a simple HTTP interface for requesting geo-registered map images from one or more distributed geospatial databases. For more specific information, please check the endpoint description.</dct:description>
    <dct:description xml:lang="es">El servicio Web Map Service (WMS) definido por el Open Geospatial Consortium (OGC) permite visualizar información geográfica como mapas. Más información específica del servicio en la descripción del punto final (dcat:endpointDescription).</dct:description>
    <dcat:endpointDescription>
      <rdfs:Resource rdf:about="https://wms.mapama.gob.es/sig/Biodiversidad/RangosEspeciesArt17/2013-2018?request=GetCapabilities&amp;service=WMS"/>
    </dcat:endpointDescription>
    <dcat:endpointURL rdf:resource="https://wms.mapama.gob.es/sig/Biodiversidad/RangosEspeciesArt17/2013-2018"/>
    <dcat:servesDataset>
      <dcat:Dataset rdf:about="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/ed02fd91-79f8-45c0-a2f0-81814cd8c19d">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="es">Rangos de Especies Artículo 17 (período 2013-2018)</dct:title>
        <dct:description xml:lang="es">Las especies de interés comunitario son un conjunto de especies seleccionadas como especialmente relevantes para la conservación de la biodiversidad en la Unión Europea. Su protección está amparada por la Directiva 92/43/CEE o Directiva Hábitats. 
El presente conjunto de datos muestra su amplitud geográfica, evaluada en el periodo 2013 a 2018, conforme a la información aportada por las administraciones competentes. 
La amplitud de esta distribución es un factor clave a la hora de conocer sus tendencias territoriales y contribuir así a mantener o alcanzar un estado una superficie de conservación favorable en el conjunto de la región biogeográfica.</dct:description>
        <dcat:landingPage rdf:resource="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/ed02fd91-79f8-45c0-a2f0-81814cd8c19d"/>
        <dct:identifier>ed02fd91-79f8-45c0-a2f0-81814cd8c19d</dct:identifier>
        <dct:type rdf:resource="http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"/>
        <dcat:keyword xml:lang="es">biosfera--organismos--ecosistemas-</dcat:keyword>
