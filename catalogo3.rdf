  <dcat:Dataset rdf:about="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/3af3c3e2-8078-4f8e-b296-d0b72529ab1e">
    <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
    <dct:title xml:lang="es">Aprovechamientos Hidroeléctricos: Central</dct:title>
    <dct:description xml:lang="es">El conjunto de datos denominado  Aprovechamientos Hidroeléctricos del Ministerio para la Transición Ecológica y el Reto Demográfico incluye información cartográfica y alfanumérica de las Centrales Hidroeléctricas, sus Tomas y su Restitución asociada. Concretamente una central hidroeléctrica es aquella infraestructura donde se centraliza la utilización del salto creado por la presa y la conducción, utilizando la energía hidráulica para la generación de energía eléctrica. El conjunto de datos de las Centrales Hidroeléctricas contiene la siguiente información: el identificador, el nombre y el tipo de central, la corriente a la que afecta, el salto bruto, el potencial total efectivo del alternador (kw) y la coordenada x e y.</dct:description>
    <dcat:landingPage rdf:resource="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/3af3c3e2-8078-4f8e-b296-d0b72529ab1e"/>
    <dct:identifier>3af3c3e2-8078-4f8e-b296-d0b72529ab1e</dct:identifier>
    <dct:type rdf:resource="http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"/>
