      <dcat:Dataset rdf:about="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/3f24b342-b46d-40e3-8991-834be9697e32">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="es">Censo Nacional de Vertidos</dct:title>
        <dct:description xml:lang="es">Censo nacional de los vertidos autorizados de aguas residuales en dominio público hidráulico y en dominio público marítimo terrestre. Los vertidos realizados en cuencas intercomunitarias son autorizados por las Confederaciones Hidrográficas; los que se realizan en cuencas intracomunitarias los autorizan las Administraciones Hidráulicas de las Comunidades Autónomas. Por último, los que se llevan a cabo en dominio público marítimo terrestre son autorizados y reportados por las Comunidades Autónomas.</dct:description>
        <dcat:landingPage rdf:resource="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/3f24b342-b46d-40e3-8991-834be9697e32"/>
