    <dcat:dataset>
      <dcat:Dataset rdf:about="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/60b0a1dd-6e9e-4ac8-aab0-827fa8957ad6">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="es">Catálogo de Sondeos</dct:title>
        <dct:description xml:lang="es">Se presenta información sintetizada de más de 8.000 sondeos de investigación hidrogeológica y geotécnica en su mayoría realizados con extracción de testigo continuo, que permite conocer con precisión la naturaleza del terreno atravesado y realizar pruebas y ensayos de tipo geotécnico e hidrogeológico. El análisis de los datos obtenidos, sus aplicaciones prácticas y las conclusiones de los estudios están recogidos en más de 2.000 informes.</dct:description>
        <dcat:landingPage rdf:resource="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/60b0a1dd-6e9e-4ac8-aab0-827fa8957ad6"/>
