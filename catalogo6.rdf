    <dcat:dataset>
      <dcat:Dataset rdf:about="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/54d5252e-ae47-46aa-8f72-5e6e5d89ac3b">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="es">Aprovechamientos Hidroeléctricos: Toma</dct:title>
        <dct:description xml:lang="es">El conjunto de datos denominado  Aprovechamientos Hidroeléctricos del Ministerio para la Transición Ecológica y el Reto Demográfico incluye información cartográfica y alfanumérica de las Centrales Hidroeléctricas, sus Tomas y su Restitución asociada. Concretamente una toma es una estructura que controla el caudal derivado y lo transmite desde el cauce natural del río o embalse hasta la central hidroeléctrica a través de una conducción (canal, tubería forzada, etc.). De cada una de las Tomas se proporciona: información del código, el nombre, el identificador de la central, la corriente a la que afecta y la coordenada x, y, z.</dct:description>
        <dcat:landingPage rdf:resource="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/54d5252e-ae47-46aa-8f72-5e6e5d89ac3b"/>
