    <dcat:dataset>
      <dcat:Dataset rdf:about="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/f674f1c0-9b31-4043-82b5-53e031267e00">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="es">Aprovechamientos Hidroeléctricos: Restitución</dct:title>
        <dct:description xml:lang="es">El conjunto de datos denominado  Aprovechamientos Hidroeléctricos del Ministerio para la Transición Ecológica y el Reto Demográfico incluye información cartográfica y alfanumérica de las Centrales Hidroeléctricas, sus Tomas y su Restitución asociada. Concretamente una restitución hace referencia al lugar de entrega del caudal turbinado en la central hidroeléctrica al cauce natural o embalse. De cada restitución se proporciona: el código, el nombre, el identificar y el nombre de la central asociada, la corriente y la coordenada x, y, z.</dct:description>
        <dcat:landingPage rdf:resource="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/f674f1c0-9b31-4043-82b5-53e031267e00"/>
