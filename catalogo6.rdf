      <dcat:Dataset rdf:about="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/4d0f156e-9660-42b0-ae09-ea8f08f7a524">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="es">Control de emisiones al Mediterráneo (Convenio Barcelona)</dct:title>
        <dct:description xml:lang="es">Este control tiene por objetivo realizar una estimación anual de la carga contaminante emitida a través los ríos que vierten sus aguas al Mar Mediterráneo (Convenio de Barcelona).</dct:description>
