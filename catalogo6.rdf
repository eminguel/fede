      <dcat:Dataset rdf:about="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/ff807602-8f60-4a10-93b8-bae44b3e1776">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="es">Control Hábitat (Control Adicional de las Zonas Protegidas)</dct:title>
        <dct:description xml:lang="es">Las masas de agua situadas en las zonas de protección de hábitats o especies de la red Natura 2000, se incluyen en el programa de control operativo cuando se considere que están en riesgo de incumplir sus objetivos medioambientales de la masa de agua. Las estaciones o puntos de muestreo seleccionados para este control se identificarán como programa de control de aguas en zonas de protección de hábitats o especies.</dct:description>
        <dcat:landingPage rdf:resource="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/ff807602-8f60-4a10-93b8-bae44b3e1776"/>
