      <dcat:Dataset rdf:about="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/48cf15c1-303b-4f31-9790-bdd114475d71">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="es">Zonas protegidas aguas potables (líneas) PHC 2015-2021</dct:title>
        <dct:description xml:lang="es">Zonas protegidas destinadas a la producción de agua de consumo humano (aguas potables). La presente versión de las masas de agua se corresponde con la que se recoge en los planes hidrológicos oficialmente aprobados para el segundo ciclo de planificación (2015-2021) e incorpora las sucesivas modificaciones y adiciones que han sufrido hasta noviembre de 2019.</dct:description>
