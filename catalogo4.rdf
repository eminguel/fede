        <dct:temporal>
          <dct:PeriodOfTime rdf:nodeID="Naa9bed972fb841eba0834585839c0685">
            <dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-01-01T00:00:00+00:00</dcat:startDate>
            <dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-12-31T00:00:00+00:00</dcat:endDate>
          </dct:PeriodOfTime>
        </dct:temporal>
        <dct:spatial rdf:resource="http://datos.gob.es/recurso/sector-publico/territorio/Pais/España"/>
        <dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/>
        <dct:provenance>
          <dct:ProvenanceStatement rdf:nodeID="N8c1781cfea0a410e8350a48727a1f2e7">
            <dct:description xml:lang="en">This dataset has been produced from information reported by operators responsible for the agricultural application of sewage sludge, collected and managed through GESLOD, the information system that supports the National Sludge Register. &#13;
Data are submitted by the entities required to report them to the Autonomous Communities, which carry out the corresponding validation and quality-control procedures before incorporating them into the National Sludge Register.&#13;
The geographic information represents the agricultural parcels where the application of sewage sludge was reported during 2025.</dct:description>
            <dct:description xml:lang="es">El conjunto de datos se ha elaborado a partir de la información declarada por los gestores responsables de la aplicación agrícola de lodos de depuración, recopilada y gestionada mediante GESLOD, la aplicación informática que soporta el Registro Nacional de Lodos. &#13;
Los datos son remitidos por los agentes obligados a su comunicación a las comunidades autónomas, que realizan los correspondientes procesos de validación y control de calidad antes de su incorporación al Registro Nacional de Lodos. &#13;
La información geográfica representa las parcelas agrícolas en las que se ha declarado la aplicación de lodos de EDAR durante el año 2025.</dct:description>
          </dct:ProvenanceStatement>
        </dct:provenance>
        <dct:accessRights rdf:resource="http://publications.europa.eu/resource/authority/access-right/PUBLIC"/>
