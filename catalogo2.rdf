    <dcat:dataset>
      <dcat:Dataset rdf:about="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/3cf5f9d1-e60d-41f2-9f18-d17237d22fa5">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="es">Dominio Público Marítimo Terrestre (Información adicional para la Servidumbre de Protección)</dct:title>
        <dct:description xml:lang="es">Polígonos que definen terrenos, mayoritariamente en islotes, que quedan totalmente afectados por la servidumbre de protección, en los que, por la pequeña extensión de su superficie, la anchura de la servidumbre de protección excede de sus dimensiones y no se puede representar la línea que define la zona afectada sujeta a dicha servidumbre.
					Los datos que se pueden consultar son: provincia, municipio, referencia y tipo de línea.</dct:description>
        <dcat:landingPage rdf:resource="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/3cf5f9d1-e60d-41f2-9f18-d17237d22fa5"/>
