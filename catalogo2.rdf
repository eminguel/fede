        <dct:provenance>
          <dct:ProvenanceStatement rdf:nodeID="Nc6fe54e9ec354c9591f7ed121ba7cd46">
            <dct:description xml:lang="en">Consumption by uses has been modeled based on the study SECH-SPAHOUSEC I (https://www.idae.es/uploads/documentos/documentos_Informe_SPAHOUSEC_ACC_f68291a3.pdf) and in the Eurostat Manual of Energy Consumption Statistics in Households (MESH) (https://ec.europa.eu/eurostat/web/products-manuals-and-guidelines/-/KS-GQ-13-003).</dct:description>
            <dct:description xml:lang="es">El consumo por usos ha sido modelizado basándose en el estudio SECH-SPAHOUSEC I (https://www.idae.es/uploads/documentos/documentos_Informe_SPAHOUSEC_ACC_f68291a3.pdf) y en el Manual de estadísticas de consumo energético en los hogares (MESH) de Eurostat (https://ec.europa.eu/eurostat/web/products-manuals-and-guidelines/-/KS-GQ-13-003).</dct:description>
          </dct:ProvenanceStatement>
        </dct:provenance>
