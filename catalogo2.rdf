    <dcat:dataset>
      <dcat:Dataset rdf:about="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/902a266d-5ba2-4735-a378-45818ba5a4f4">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="en">Fueling facilities for vehicles and ships with public sales</dct:title>
        <dct:title xml:lang="es">Instalaciones de suministro de combustibles a vehículos y embarcaciones con venta pública</dct:title>
        <dct:description xml:lang="en">Information on petrol stations and maritime poles with data on their geographical location – address, margin and geographical coordinates – and prices for the fuels and products sold –gasolines, diesels, bioethanol and biodiesel, LPG, compressed and liquefied natural gas, hydrogen, renewable diesel and gasoline, diesel for sea use, methanol, ammonia, compressed and liquefied natural biogas, and Adblue – along with data on signage, type of sale, hours and type of service offered and discount plans, with different formats.</dct:description>
        <dct:description xml:lang="es">Información de estaciones de servicio y postes marítimos con datos de su ubicación geográfica – dirección, margen y coordenadas geográficas- y precios actuales para los combustibles y productos comercializados -gasolinas, gasóleos, bioetanol y biodiésel, GLP, gas natural comprimido y licuado, hidrógeno, diésel y gasolina renovables, gasóleo para uso marítimo, metanol, amoníaco, biogás natural comprimido y licuado, y Adblue-, junto con datos sobre rótulo, tipo de venta, horario y tipo de servicio ofrecido y planes de descuento, en distintos formatos</dct:description>
        <dcat:landingPage rdf:resource="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/902a266d-5ba2-4735-a378-45818ba5a4f4"/>
        <dct:identifier>902a266d-5ba2-4735-a378-45818ba5a4f4</dct:identifier>
        <dct:type rdf:resource="http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"/>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-07-15T00:00:00+00:00</dct:modified>
        <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-07-26T00:00:00+00:00</dct:issued>
        <dct:language rdf:resource="http://publications.europa.eu/resource/authority/language/SPA"/>
