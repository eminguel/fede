        <owl:versionInfo>1.0</owl:versionInfo>
        <dct:accrualPeriodicity rdf:resource="http://publications.europa.eu/resource/authority/frequency/BIWEEKLY"/>
        <dct:type rdf:resource="http://inspire.ec.europa.eu/metadata-codelist/ResourceType/dataset"/>
        <dcat:keyword xml:lang="es">boletin-hidrológico-semanal</dcat:keyword>
