        <dcat:contactPoint rdf:resource="https://catalogo.datosabiertos.miteco.gob.es/kos/role/E05068001/contact"/>
        <dct:temporal>
          <dct:PeriodOfTime rdf:nodeID="N9be91e4d838242169aca0b85b11a5ced">
            <dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2007-07-26T00:00:00+00:00</dcat:startDate>
          </dct:PeriodOfTime>
        </dct:temporal>
        <dct:spatial rdf:resource="http://datos.gob.es/recurso/sector-publico/territorio/Pais/España"/>
        <dct:conformsTo rdf:resource="http://www.opengis.net/def/crs/EPSG/0/4258"/>
        <dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/>
        <dct:provenance>
          <dct:ProvenanceStatement rdf:nodeID="Ne19e21487bbc4c40b75a8b5d2ed1d11f">
            <dct:description xml:lang="en">Data obtained from information submitted by the owners pursuant to Order ITC/2308/2007, of July 25, which establishes the method for submitting information to the Ministry of Industry, Tourism and Trade regarding petroleum product supply activities and data collection in the Census of Fuel Supply Facilities, through the RISP CARBURANTES application enabled for this purpose.&#13;
Companies register in this census and enter the corresponding data for the company and its contacts, information on fuel supply facilities, service station management, discount maps, differentiated sales, and users.&#13;
At least weekly, they update the prices of the fuels sold, which are published on the Geoportal Gasolineras website, maintaining a price history.&#13;
Applications are evaluated and approved by the MITECO managers.</dct:description>
            <dct:description xml:lang="es">Datos obtenidos a partir de las informacion remitida por los sujetos titulares en virtud de la Orden ITC/2308/2007, de 25 de julio, por la que se determina la forma de remisión de información al Ministerio de Industria, Turismo y Comercio sobre las actividades de suministro de productos petrolíferos y recogida en el Censo de instalaciones de suministro de carburantes, a través de la aplicación RISP CARBURANTES habilitado para dar cumplimiento a lo anterior.&#13;
Las empresas se dan de alta en dicho censo e introducen los datos correspondientes a la empresa y sus contactos, información de las instalaciones de suministro de combustible, gestión de la estación de servicio, planes de descuento, ventas diferenciadas y usuarios.&#13;
Con frecuencia mínima semanal suben precios de los combustibles comercializados que son publicados en la página de Geoportal Gasolineras, manteniendo un histórico de los mismos.&#13;
Las solicitudes son evaluadas y aprobadas por los gestores del MITECO.</dct:description>
          </dct:ProvenanceStatement>
        </dct:provenance>
