        <dct:temporal>
          <dct:PeriodOfTime rdf:nodeID="N65401b2eafb647d7b34587c076dc6421">
            <dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">1990-01-01T00:00:00+00:00</dcat:startDate>
            <dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-12-31T00:00:00+00:00</dcat:endDate>
          </dct:PeriodOfTime>
