        <dct:spatial rdf:resource="http://datos.gob.es/recurso/sector-publico/territorio/Pais/España"/>
        <dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/>
        <dct:provenance>
          <dct:ProvenanceStatement rdf:nodeID="N8840bed6b4e347ca9f15f7b38199cb1b">
            <dct:description xml:lang="en">Data is requested from companies, associations, and institutional bodies of the General State Administration and the Autonomous Communities regarding activity parameters and variables, information on algorithms and emission factors, and, where applicable, on measured or estimated emissions and, in general, the information necessary for applying the methods selected for each activity. The emissions from each activity are verified and calculated according to the EMEP/EEA guidelines. Successive quality controls are carried out throughout the process. For more information, see Chapter 1 of the IIR, at https://www.miteco.gob.es/es/calidad-y-evaluacion-ambiental/temas/sistema-espanol-de-inventario-sei-.html.</dct:description>
            <dct:description xml:lang="es">Se solicitan datos a empresas, asociaciones, organismos institucionales de la Administración General del Estado y de las Comunidades Autónomas de parámetros y variables de actividad, información sobre algoritmos y factores de emisión, y, en su caso, sobre emisiones medidas o estimadas y, en general, de la información necesaria para la aplicación de los métodos seleccionados según la actividad. Se verifican y se calculan las emisiones de cada una de las actividades según las directrices de las guías EMEP/EEA. A lo largo del proceso se realizan sucesivos controles de calidad a lo largo del proceso. Para más información, capítulo 1 del NID, en https://www.miteco.gob.es/es/calidad-y-evaluacion-ambiental/temas/sistema-espanol-de-inventario-sei-.html.</dct:description>
          </dct:ProvenanceStatement>
        </dct:provenance>
