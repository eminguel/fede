        <dct:type rdf:resource="http://id.loc.gov/vocabulary/marcgt/dtb"/>
        <dcat:keyword xml:lang="es">contaminantes-atmosféricos</dcat:keyword>
        <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-04-07T00:00:00+00:00</dct:modified>
        <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-03-15T00:00:00+00:00</dct:issued>
