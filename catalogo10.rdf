        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="es">Zonas con potenciales alto y moderado de entrada de basura marina desde el mar en la Demarcación Sudatlántica (EM SUD PRE ZO Basura Marina)</dct:title>
        <dct:description xml:lang="es">Se han identificado las zonas con mayor densidad de barcos pesqueros (esto es, las zonas con mayor número de registros VMS), así como las zonas con mayor densidad de buques mercantes (AIS), sumando las señales recibidas de ambas fuentes sobre cada celda (transformados los datos VMS a señales emitidas cada 5 minutos, para hacerlos comparables con los AIS).</dct:description>
        <dcat:landingPage rdf:resource="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/2c4e3f2f-1109-40c9-ac40-0b3b722b1e41"/>
