          <dct:PeriodOfTime rdf:nodeID="N759417bdad2c468db16ba3eb00fb12b4">
            <dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">1990-01-01T00:00:00+00:00</dcat:startDate>
            <dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2025-12-31T00:00:00+00:00</dcat:endDate>
          </dct:PeriodOfTime>
        </dct:temporal>
        <dct:spatial rdf:resource="http://datos.gob.es/recurso/sector-publico/territorio/Pais/España"/>
        <dct:conformsTo rdf:resource="http://www.opengis.net/def/crs/EPSG/0/3857"/>
        <dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/>
        <dct:provenance>
          <dct:ProvenanceStatement rdf:nodeID="Ne4647aa6c20e4f5cb2a9cabc1fb4c23a">
            <dct:description xml:lang="en">The energy balance results from different sources: MITECO, IDAE, CORES, REE, ENAGAS, CNMC, MITMA, and Customs. It is obtained through various questionnaires relating to product categories (coal, electricity, natural gas, renewable energy and waste, petroleum products, and nuclear energy).</dct:description>
            <dct:description xml:lang="es">En la elaboración del balance energético se utilizan resultados procedentes de distintas fuentes (MITECO, IDAE, CORES, REE, ENAGAS, CNMC, MITMA, ADUANAS) a través de diferentes cuestionarios referentes a categorías de productos (carbón, electricidad,  gas natural, energías renovables y residuos, productos petrolíferos y energía nuclear).</dct:description>
          </dct:ProvenanceStatement>
        </dct:provenance>
