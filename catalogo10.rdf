        <dct:creator rdf:resource="https://catalogo.datosabiertos.miteco.gob.es/kos/role/EA0046225-%20v2/creator"/>
        <dct:temporal>
          <dct:PeriodOfTime rdf:nodeID="N825f2eb3df4f4620b0ad772dcbdd67da">
            <dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2023-01-01T00:00:00+00:00</dcat:startDate>
            <dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2024-12-31T00:00:00+00:00</dcat:endDate>
          </dct:PeriodOfTime>
        </dct:temporal>
        <dct:spatial rdf:resource="http://datos.gob.es/recurso/sector-publico/territorio/Pais/España"/>
        <dct:license rdf:resource="http://publications.europa.eu/resource/authority/licence/CC_BY_4_0"/>
        <dct:provenance>
          <dct:ProvenanceStatement rdf:nodeID="Naa5ecf96e7e24a12ab0904c3b33161a3">
            <dct:description xml:lang="en">This dataset is compiled through a full census of official sources (MITECO, IDAE, Customs, REE, CORES) and sectoral sources, collected electronically and subjected to automatic validation and cleaning in two phases (micro and aggregated). The data may undergo occasional revisions due to corrections from the respondents and show decadal series breaks in biomass, biogas, and heat pumps due to ad-hoc studies. The entire process follows the standards of Regulation (EU) 2024/264 and the Code of Good Practice of European Statistics (ESSCoP).</dct:description>
            <dct:description xml:lang="es">Este dataset se compila mediante censo completo de fuentes oficiales (MITECO, IDAE, Aduanas, REE, CORES) y sectoriales, recogidas electrónicamente y sometidas a validación automática y depuración en dos fases (micro y agregada). Los datos pueden sufrir revisiones puntuales ante correcciones de los informantes y presentan rupturas de serie decenales en biomasa, biogás y bombas de calor por estudios ad-hoc. Todo el proceso sigue los estándares del Reglamento (UE) 2024/264 y el Código de Buenas Prácticas de las Estadísticas Europeas (ESSCoP).</dct:description>
          </dct:ProvenanceStatement>
        </dct:provenance>
