    <dcat:dataset>
      <dcat:Dataset rdf:about="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/e0283e55-4e74-4cc1-9d90-b00ddbe3c59d">
        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="es">Vulnerabilidad de la costa. Indice de vulnerabilidad socioeconómica</dct:title>
        <dct:description xml:lang="es">Información sobre la vulnerabilidad socioeconómica, calculada en base a parámetros industrial, pesquero, turístico y de población y normalizada en el rango de 0 a 1. Forma parte del Plan Estatal de Protección de Ribera del Mar contra la Contaminación, que es un plan de contingencias para sucesos de contaminación grave en la costa que forma parte del Sistema Nacional de Respuesta ante la Contaminación Marina Accidental, y ha sido aprobado mediante la Orden AAA/702/2014.</dct:description>
        <dcat:landingPage rdf:resource="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/e0283e55-4e74-4cc1-9d90-b00ddbe3c59d"/>
