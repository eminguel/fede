  <dcat:Dataset rdf:about="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/99c59f04-b6d0-4f1d-9781-34365df14093">
    <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
    <dct:title xml:lang="es">Zonas con potenciales alto y moderado de aportes de basuras al mar desde tierra en la Demarcación Canaria (EM CAN PRE ZO Basura Terrestre)</dct:title>
    <dct:description xml:lang="es">Se han seleccionado zonas de potencial alto de aporte de basuras a partir de las celdas clasificadas por el rango “Muy Alto” y zonas de potencial moderado a partir de las celdas clasificadas por el rango “Alto” en el Mallado de basura de origen terrestre de la Demarcación Canaria.</dct:description>
