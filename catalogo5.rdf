          <dct:PeriodOfTime rdf:nodeID="Ncd2d93e3c36740daa6cc36781e2ee93e">
            <dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">1987-10-06T00:00:00+00:00</dcat:startDate>
            <dcat:endDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2100-01-01T00:00:00+00:00</dcat:endDate>
          </dct:PeriodOfTime>
