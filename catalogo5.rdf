        <rdf:type rdf:resource="http://xmlns.com/foaf/0.1/Document"/>
        <dct:title xml:lang="en">Residential Energy Consumption Statistics</dct:title>
        <dct:title xml:lang="es">Estadística de Consumo Energético Residencial</dct:title>
        <dct:description xml:lang="en">It provides annual information on consumption in the residential sector in Spain by uses.</dct:description>
        <dct:description xml:lang="es">Proporciona información anual sobre el consumo en el sector residencial en España por usos.​</dct:description>
        <dcat:landingPage rdf:resource="https://catalogo.datosabiertos.miteco.gob.es/catalogo/dataset/0f1e2f2e-c315-4b30-9e2c-dc207cfa78be"/>
