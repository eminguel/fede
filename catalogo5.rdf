        <dct:temporal>
          <dct:PeriodOfTime rdf:nodeID="N0486b38c2d444631a510c96d813ac239">
            <dcat:startDate rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">1993-06-23T00:00:00+00:00</dcat:startDate>
          </dct:PeriodOfTime>
