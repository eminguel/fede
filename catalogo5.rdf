        <dct:creator>
          <foaf:Agent rdf:nodeID="N99d1573cf7b54b7e98d52e5bd7ec3877">
            <foaf:name xml:lang="es">Subdirección General de Energía Eléctrica</foaf:name>
            <foaf:mbox rdf:resource="mailto:bzn-sgeelectrica@miteco.es"/>
            <foaf:homepage rdf:resource="https://www.miteco.gob.es/es/energia/energia-electrica/electricidad.html"/>
